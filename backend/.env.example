# Copy to .env and fill in real values. Never commit .env.

# Anthropic API key — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL connection string.
# Local Docker (docker compose up db):
#   postgresql://jobtracker:jobtracker@localhost:5432/jobtracker
# Supabase: Project Settings → Database → Connection string → Session pooler.
#   Must be a postgresql:// URI, not the https:// project URL.
DATABASE_URL=postgresql://jobtracker:jobtracker@localhost:5432/jobtracker

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
